/******************************************************************************

Exercise 1(Non-Function)

Write an algorithm and draw its flowchart to accept two numbers and display
the maximum number.

*******************************************************************************/
#include <iostream>
using namespace std;

int main()
{
    int num1, num2;
    cout << "Enter two numbers: ";
    cin >> num1 >> num2;
    
    if (num1 > num2) {
        cout << num1 << " is the max number";
    }else if (num1 > num2) {
        cout << num2 << " is the max number";
    }else{
        cout << num1 << " and " << num2 << " are max numbers";
    }
    
    
    return 0;
}
