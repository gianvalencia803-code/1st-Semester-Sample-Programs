/******************************************************************************

Multiplication Table Generator with ODD/EVEN Identifier 

3 x 1 = 3 (Odd)
3 x 2 = 6 (Even)

*******************************************************************************/
#include <iostream>

using namespace std;

int main()
{
    int number, limit, product;
    
    cout << "Enter a number: ";
    cin >> number;
    
    cout << "Enter table limit: ";
    cin >> limit;
    
    if(limit <0){
        cout << "Limit must be positive. ";
        return 0;
    }
    
    for(int i=1;i<=limit;i++){
        product = number * i;
        cout << number <<" X "<< i <<" = "<<product;
        
        if(product % 2==0){
            cout <<" (EVEN)";
        }else{
            cout <<" (ODD)";
        }
        
        cout<<endl;
    }
    
    return 0;
}
